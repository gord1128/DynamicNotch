    "settings.general.display.autoSwitch.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the main display while the selected display is unavailable, then move Dynamic Notch back when it returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la pantalla principal mientras la pantalla seleccionada no esté disponible y devuelve Dynamic Notch cuando vuelva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать основной дисплей, пока выбранный дисплей недоступен, и возвращать Dynamic Notch обратно, когда он появится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当所选显示屏不可用时使用主显示屏，并在其恢复后将 Dynamic Notch 移回去。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 디스플레이를 사용할 수 없을 때 기본 디스플레이를 사용하고, 돌아오면 Dynamic Notch를 다시 이동하세요."
          }
        }
      }
