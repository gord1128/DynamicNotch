    "settings.general.display.unavailable.autoSwitchDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected display is unavailable right now. Dynamic Notch will stay hidden until that display returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla seleccionada no está disponible ahora mismo. Dynamic Notch permanecerá oculto hasta que vuelva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный дисплей сейчас недоступен. Dynamic Notch останется скрытым, пока этот дисплей не вернётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选显示屏当前不可用。Dynamic Notch 会保持隐藏，直到该显示屏重新连接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 디스플레이를 지금은 사용할 수 없습니다. Dynamic Notch는 해당 디스플레이가 돌아올 때까지 숨겨진 상태로 유지됩니다."
          }
        }
      }
    },
