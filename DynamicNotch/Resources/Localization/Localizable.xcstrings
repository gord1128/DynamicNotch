    "settings.notch.height.description": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tune the notch height to better match your display cutout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la altura de la muesca para que coincida mejor con el recorte de su pantalla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрегулируйте высоту выреза так, чтобы она лучше соответствовала вырезу дисплея."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微调凹口高度以更好地匹配您的显示屏切口。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 컷아웃에 더 잘 맞도록 노치 높이를 미세 조정하세요."
          }
        }
