    "settings.notch.priorities.help": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The higher the number of an event, the higher its priority over others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más alto sea el número de un evento, mayor será su prioridad sobre los demás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше число события, тем выше его приоритет над остальными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件数字越高，相对于其他事件的优先级越高。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 수가 많을수록 다른 이벤트보다 우선순위가 높아집니다."
          }
        }
