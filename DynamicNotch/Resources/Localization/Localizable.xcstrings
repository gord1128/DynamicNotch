    "settings.notch.defaultStroke.description": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the standard white stroke to supported activities instead of feature accent colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique el trazo blanco estándar a las actividades admitidas en lugar de resaltar los colores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяйте стандартную белую обводку к поддерживаемым действиям вместо акцентных цветов функций."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标准白色描边应用于支持的活动，而不是特征强调色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특징 강조 색상 대신 지원되는 활동에 표준 흰색 획을 적용합니다."
          }
        }
      }
    },
    "settings.notch.defaultStroke.title": {
      "extractionState": "stale",
