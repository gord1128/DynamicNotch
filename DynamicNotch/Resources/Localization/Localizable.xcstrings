    "settings.notch.priorities.customOrder.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher numbers appear above lower numbers when activities overlap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números más altos aparecen por encima de los más bajos cuando las actividades se superponen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше число, тем выше активность показывается при пересечении событий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动重叠时，数字越高显示越靠前。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동이 겹치는 경우 높은 숫자가 낮은 숫자 위에 표시됩니다."
          }
        }
      }
    },
